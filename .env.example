# Copy to .env — never commit real credentials.

# Auth (required): DevTools → Cookies → linkedin.com → li_at
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

SESSION_STATE_PATH=session_state.json

# HTTP
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENT_SCRAPES=2
SECTION_FETCH_CONCURRENCY=3
SECTION_FETCH_DELAY_MS=600
USER_AGENT=

# Cache
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

# API
# API_KEY=
LOG_LEVEL=INFO
INCLUDE_DEBUG=false
