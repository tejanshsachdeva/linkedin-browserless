# Copy to .env — never commit real credentials.

# Auth (required): DevTools → Cookies → linkedin.com → li_at
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

SESSION_STATE_PATH=session_state.json

# HTTP
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENT_SCRAPES=2
SECTION_FETCH_CONCURRENCY=3
SECTION_FETCH_DELAY_MS=600
USER_AGENT=

# Cache
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

# API — set API_KEY to require X-API-Key header (disables /docs when set)
API_KEY=

# --- Admin / credential rotation ---
# Required to use /admin/session/*. Separate from API_KEY because rotation
# installs a password-equivalent secret. If unset, those endpoints return
# 503 (fail closed) rather than being publicly reachable.
# Generate with:  openssl rand -hex 32
ADMIN_API_KEY=

# --- Alerting (any URL accepting a JSON POST; Slack/Discord work as-is) ---
ALERT_WEBHOOK_URL=
SERVICE_NAME=linkedin-profile-api
ROTATION_ENDPOINT_HINT=
ENABLE_DOCS=false
PORT=8000

LOG_LEVEL=INFO
INCLUDE_DEBUG=false
